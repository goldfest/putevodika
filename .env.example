# Скопируйте этот файл в .env.
# .env уже исключен из Git.

# Обязательный JWT secret в Base64, минимум 32 байта исходных данных.
JWT_SECRET=REPLACE_WITH_BASE64_SECRET

# Frontend
PASSWORD_RESET_URL=http://localhost:5173/reset-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Локальная HTTP-разработка.
# На production с HTTPS: AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Почта.
# По умолчанию Docker Compose использует локальный Mailpit.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_FROM=no-reply@putevodika.local
