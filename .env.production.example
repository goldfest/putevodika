# Backend
BACKEND_HOST_PORT=8081

# PostgreSQL
POSTGRES_DB=putevodika
POSTGRES_USER=putevodika
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# JWT
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_BASE64_JWT_SECRET

# Frontend
PASSWORD_RESET_URL=https://putevodika.ru/reset-password
CORS_ALLOWED_ORIGINS=https://putevodika.ru

# Auth cookies
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax

# SMTP / Yandex
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_YANDEX_EMAIL
MAIL_PASSWORD=CHANGE_ME_YANDEX_APP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=CHANGE_ME_YANDEX_EMAIL

# OSRM
OSRM_DATASET=ulyanovsk_oblast-latest